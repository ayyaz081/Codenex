# Environment Configuration Template
# Copy this file to .env.development or .env.production and fill in your actual values
# NEVER commit actual .env files with real credentials!

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_CONNECTION_STRING=your_database_connection_string_here

# ============================================
# JWT CONFIGURATION (minimum 32 characters)
# ============================================
# Generate a secure key: openssl rand -base64 32
JWT_KEY=your_jwt_secret_key_minimum_32_characters_long
JWT_ISSUER=YourAppName
JWT_AUDIENCE=YourAppName
JWT_EXPIRY_HOURS=24

# ============================================
# ADMIN CONFIGURATION
# ============================================
# Initial admin account (created on first startup)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=YourSecurePassword123!

# Admin creation API secret (required to create admin via API)
# Generate: openssl rand -base64 32
ADMIN_CREATION_SECRET=your_admin_creation_secret_here

# ============================================
# EMAIL CONFIGURATION - Gmail SMTP
# ============================================
# Gmail SMTP Settings
# For Gmail App Password: https://myaccount.google.com/apppasswords
EmailSettings__Host=smtp.gmail.com
EmailSettings__Port=587
EmailSettings__FromEmail=your_gmail@gmail.com
EmailSettings__FromName=Your Company Name
EmailSettings__Username=your_gmail@gmail.com
EmailSettings__Password=your_gmail_app_password
EmailSettings__EnableSsl=true
REQUIRE_EMAIL_CONFIRMATION=false

# ============================================
# ENVIRONMENT
# ============================================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:8080
API_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
EMAIL_VERIFICATION_PATH=/api/auth/verify-email
PASSWORD_RESET_PATH=/Auth

# ============================================
# GITHUB INTEGRATION
# ============================================
# Create PAT: https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_personal_access_token
GITHUB_ORGANIZATION_NAME=your_organization_name

# ============================================
# STRIPE PAYMENT INTEGRATION
# ============================================
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_SUCCESS_URL=http://localhost:8080/Repository?payment=success
STRIPE_CANCEL_URL=http://localhost:8080/Repository?payment=cancel

# ============================================
# RECAPTCHA v3
# ============================================
# Get keys from: https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
RECAPTCHA_MIN_SCORE=0.5

# ============================================
# MISCELLANEOUS
# ============================================
BOOKING_CALENDAR_URL=https://your-booking-calendar-url

# ============================================
# NOTES FOR PRODUCTION
# ============================================
# 1. Use strong, randomly generated secrets for all keys
# 2. Store credentials in your hosting platform's environment variables:
#    - Azure: App Service > Configuration > Application Settings
#    - AWS: Elastic Beanstalk > Configuration > Environment Properties
#    - IIS: Configuration Editor > system.webServer/aspNetCore > environmentVariables
# 3. Enable REQUIRE_EMAIL_CONFIRMATION=true in production
# 4. Set ASPNETCORE_ENVIRONMENT=Production
# 5. Use production Stripe keys (sk_live_... and pk_live_...)
# 6. Never commit .env files to version control
